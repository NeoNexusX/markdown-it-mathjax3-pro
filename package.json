{
  "name": "markdown-it-mathjax3-pro",
  "version": "1.1.0",
  "description": "A markdown-it plugin for MathJax 3 with server-side and client-side rendering, batch processing and configurable delimiters",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist example/dist",
    "test": "npm run build && node --test test/index.test.js",
    "test:e2e": "npm run build && node --test test/e2e.test.js",
    "test:all": "npm run build && node --test test/index.test.js test/e2e.test.js",
    "e2e:install": "playwright-core install chromium",
    "example": "npm run build && tsc -p example/tsconfig.json && node example/dist/example/test.js && node example/dist/example/test4csr.js",
    "prepublishOnly": "npm run clean && npm run build && node --test test/index.test.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dependencies": {
    "mathjax-full": "^3.2.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "markdown-it": "^14.1.0",
    "playwright-core": "^1.62.1",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "markdown-it": ">=12.0.0"
  },
  "keywords": [
    "markdown-it",
    "markdown-it-plugin",
    "mathjax",
    "mathjax3",
    "math",
    "latex",
    "tex",
    "ssr",
    "vitepress",
    "typescript"
  ],
  "author": "NeoNexusX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeoNexusX/markdown-it-mathjax3-pro.git"
  },
  "homepage": "https://github.com/NeoNexusX/markdown-it-mathjax3-pro#readme",
  "bugs": {
    "url": "https://github.com/NeoNexusX/markdown-it-mathjax3-pro/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
